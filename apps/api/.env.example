# ============================================================
# ROS API — Environment (คัดลอกเป็น .env)
# ============================================================

NODE_ENV=development
PORT=4000

# Database (ใช้ตัวเดียวกับ db/.env — Phase 11)
DATABASE_URL="postgresql://iiamtikm@localhost:5432/ros?schema=public&host=/tmp"

# CORS — origin ที่อนุญาต (web-public + web-admin)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# JWT (Phase 7) — dev มี default ใน code; production ต้องตั้งค่าจริง (secret แข็งแรง)
JWT_ACCESS_SECRET=dev_access_secret_change_me_please
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
