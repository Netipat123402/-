{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm -v)",
      "Bash(pnpm -v)",
      "Bash(docker -v)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npx tsc *)",
      "Bash(npx prisma *)",
      "Bash(npx nest *)",
      "Bash(npx jest *)",
      "Bash(git worktree *)"
    ]
  }
}
