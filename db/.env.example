# Connection สำหรับ dev local (ตรงกับ infra/docker/docker-compose.yml)
DATABASE_URL="postgresql://ros:ros_dev_password@localhost:5432/ros?schema=public"

# Production (VPS) — ใช้รหัสผ่านที่แข็งแรง + เก็บใน secret manager
# DATABASE_URL="postgresql://ros:CHANGE_ME_STRONG@postgres:5432/ros?schema=public&connection_limit=20"
