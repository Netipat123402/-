# ============================================================================
# ROS Backup config — คัดลอกเป็น backup.env แล้วแก้ค่า (ถ้าไม่มี จะใช้ default dev)
# ============================================================================

# --- ที่เก็บ backup ในเครื่อง ---
# (default: $HOME/ros-backups) — อย่าชี้เข้า working dir ที่ sync/iCloud
# BACKUP_DIR="/srv/ros-backups"

# --- โฟลเดอร์ไฟล์อัปโหลด ---
# (default: <project>/apps/api/uploads)
# UPLOADS_DIR="/srv/ros/apps/api/uploads"

# --- เก็บ backup กี่วัน (prune อัตโนมัติ) ---
RETENTION_DAYS=14

# --- การเชื่อมต่อฐานข้อมูล ---
# วิธี A (prod): ใช้ DATABASE_URL เดียวกับแอป — script จะแปลงเป็น PG* ให้เอง
# DATABASE_URL="postgresql://ros:STRONG_PW@localhost:5432/ros?schema=public"
#
# วิธี B (dev): ปล่อยว่าง = ใช้ Postgres.app (socket /tmp, user=$USER, db=ros)

# ============================================================================
# Offsite (ส่ง backup ออกนอกเครื่อง) — ⚠️ จำเป็นจริงตาม MR-01 acceptance
# เปิดใช้งานเมื่อมีปลายทาง (เช่น MinIO/S3 จาก MR-04) แล้วตั้ง OFFSITE_MODE
# ============================================================================

# OFFSITE_MODE=none            # none | mc | aws | rsync

# -- mc (MinIO / S3-compatible) ต้อง `mc alias set` ไว้ก่อน --
# OFFSITE_MODE=mc
# OFFSITE_MC_TARGET="myminio/ros-backups"

# -- aws (S3 / Cloudflare R2) --
# OFFSITE_MODE=aws
# OFFSITE_S3_URI="s3://ros-backups"

# -- rsync ไปเครื่องสำรอง --
# OFFSITE_MODE=rsync
# OFFSITE_RSYNC_TARGET="user@backup-host:/srv/ros-backups"
