# ============================================================================
# ROS — Production env (MR-02) · คัดลอกเป็น .env.prod แล้วแก้ค่า (อย่า commit)
# ใช้กับ: docker compose -f infra/docker/docker-compose.prod.yml --env-file infra/docker/.env.prod ...
# ============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=ros
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PW
POSTGRES_DB=ros

# DATABASE_URL ต้องชี้ไปที่ service "postgres" ใน compose network
DATABASE_URL=postgresql://ros:CHANGE_ME_STRONG_DB_PW@postgres:5432/ros?schema=public

# ---- Secrets (บังคับใน production — บูตไม่ขึ้นถ้าไม่ตั้ง) ----
# สร้าง: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX
# PII key = hex 64 ตัว (32 bytes) — ⚠️ เก็บสำรองแยก! หายแล้วถอด idCard ไม่ได้
PII_ENCRYPTION_KEY=CHANGE_ME_64_HEX
# secret ของ ISR revalidation webhook (api → web-public)
REVALIDATE_SECRET=CHANGE_ME_RANDOM

# ---- Reverse proxy + TLS (Caddy — MR-07) ----
# โดเมนจริง 3 ตัว (ชี้ A record มาที่ VPS) — Caddy ออก cert อัตโนมัติ
PUBLIC_DOMAIN=rent.example.com
ADMIN_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
TRUST_PROXY=1                      # จำนวน proxy hop (Caddy = 1)

# ---- Networking / CORS (ใช้ https หลังมี Caddy) ----
CORS_ORIGINS=https://rent.example.com,https://app.example.com
NEXT_PUBLIC_API_BASE=https://api.example.com/api/v1
API_BASE_INTERNAL=http://api:4000/api/v1        # ภายใน compose network
WEB_PUBLIC_REVALIDATE_URL=http://web-public:3000/api/revalidate

# มี HTTPS แล้ว → ต้องเป็น true (production fail-fast ถ้าไม่ใช่)
COOKIE_SECURE=true

# (ไม่มี Published ports — api/web เข้าถึงผ่าน Caddy 443 เท่านั้น)

# ---- Observability (MR-03) ----
LOG_FORMAT=json                 # json (prod) | pretty
# SENTRY_DSN=                    # ตั้ง = เปิด error tracking (ไม่ตั้ง = ปิด)
SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=
# METRICS_TOKEN=                 # ตั้ง = /metrics ต้องใส่ Bearer (แนะนำใน prod)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PW

# ---- Storage / MinIO (MR-04) ----
STORAGE_DRIVER=s3                 # s3 (MinIO) | local
STORAGE_BUCKET=ros-files
MINIO_ROOT_USER=ros_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PW
# S3_ENDPOINT ภายใน compose = http://minio:9000 (ตั้ง default แล้ว)
# URL สาธารณะของรูปทรัพย์ (แยก domain/CDN) — ชี้มาที่ MinIO bucket/prefix properties
# เช่น https://files.example.com/ros-files  (หรือ http://<host>:9000/ros-files)
STORAGE_PUBLIC_URL=
BACKUP_BUCKET=ros-backups         # bucket สำรอง (เชื่อม MR-01 offsite)

# ---- prepared (MR-41) ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PW
