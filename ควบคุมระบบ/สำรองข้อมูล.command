#!/bin/bash
# ============================================================
#  💾 สำรองข้อมูล ROS  (ดับเบิลคลิกเพื่อสำรอง)
#  สำรอง: ฐานข้อมูล + ไฟล์อัปโหลด → ~/ros-backups/
#  แล้วทดสอบ restore อัตโนมัติว่ากู้คืนได้จริง
# ============================================================

cd "$(dirname "$0")/.." || exit 1
ROOT="$(pwd)"

echo ""
echo "================================================="
echo "   💾  กำลังสำรองข้อมูล ROS ..."
echo "================================================="
echo ""

bash "$ROOT/infra/backup/backup.sh"
RC=$?

if [ $RC -ne 0 ]; then
  echo ""
  echo "   ⚠ สำรองข้อมูลล้มเหลว (rc=$RC) — ดูข้อความด้านบน"
  echo ""
  read -n 1 -s -r -p "กดปุ่มใดก็ได้เพื่อปิด..."
  exit $RC
fi

echo ""
echo "[ทดสอบ] กำลังตรวจว่ากู้คืนได้จริง..."
echo ""
bash "$ROOT/infra/backup/test-restore.sh"
TRC=$?

echo ""
echo "================================================="
if [ $TRC -eq 0 ]; then
  echo "   ✅ สำรองข้อมูล + ทดสอบกู้คืน สำเร็จ!"
  echo "   ไฟล์อยู่ที่: ~/ros-backups/"
else
  echo "   ⚠ สำรองได้ แต่ทดสอบกู้คืนไม่ผ่าน — ตรวจสอบด่วน!"
fi
echo "================================================="
echo ""
read -n 1 -s -r -p "กดปุ่มใดก็ได้เพื่อปิด..."
